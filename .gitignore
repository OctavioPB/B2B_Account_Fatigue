# =============================================================================
# harmoni — .gitignore
# =============================================================================

# --- Secrets (NEVER commit) ---
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.uv/
dist/
build/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
next-env.d.ts

# --- Terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Docker ---
*.log

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- dbt ---
pipelines/dbt/target/
pipelines/dbt/dbt_packages/
pipelines/dbt/logs/

# --- Airflow ---
airflow.cfg
airflow_settings.yaml
standalone_admin_password.txt

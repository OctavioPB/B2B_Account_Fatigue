# profiles.yml.example
# ---------------------------------------------------------------------------
# Copy to ~/.dbt/profiles.yml (or pipelines/dbt/profiles.yml for local dev).
# NEVER commit the real profiles.yml — it contains database credentials.
# All values should come from environment variables in production.
# ---------------------------------------------------------------------------

harmoni:
  target: dev

  outputs:
    # ------------------------------------------------------------------
    # dev — PostgreSQL (local docker-compose)
    # ------------------------------------------------------------------
    dev:
      type: postgres
      host: "{{ env_var('DBT_PG_HOST', 'localhost') }}"
      port: "{{ env_var('DBT_PG_PORT', '5432') | int }}"
      user: "{{ env_var('DBT_PG_USER', 'harmoni') }}"
      password: "{{ env_var('DBT_PG_PASSWORD', 'harmoni') }}"
      dbname: "{{ env_var('DBT_PG_DBNAME', 'harmoni') }}"
      schema: public
      threads: 4
      keepalives_idle: 0

    # ------------------------------------------------------------------
    # staging — PostgreSQL (AWS RDS staging)
    # ------------------------------------------------------------------
    staging:
      type: postgres
      host: "{{ env_var('DBT_PG_HOST') }}"
      port: 5432
      user: "{{ env_var('DBT_PG_USER') }}"
      password: "{{ env_var('DBT_PG_PASSWORD') }}"
      dbname: harmoni
      schema: public
      threads: 8
      keepalives_idle: 0
      sslmode: require

    # ------------------------------------------------------------------
    # prod — PostgreSQL (AWS RDS production)
    # ------------------------------------------------------------------
    prod:
      type: postgres
      host: "{{ env_var('DBT_PG_HOST') }}"
      port: 5432
      user: "{{ env_var('DBT_PG_USER') }}"
      password: "{{ env_var('DBT_PG_PASSWORD') }}"
      dbname: harmoni
      schema: public
      threads: 16
      keepalives_idle: 0
      sslmode: require

    # ------------------------------------------------------------------
    # clickhouse — ClickHouse (local docker-compose or cloud)
    # ------------------------------------------------------------------
    clickhouse:
      type: clickhouse
      schema: harmoni
      host: "{{ env_var('CLICKHOUSE_HOST', 'localhost') }}"
      port: "{{ env_var('CLICKHOUSE_PORT', '8123') | int }}"
      user: "{{ env_var('CLICKHOUSE_USER', 'default') }}"
      password: "{{ env_var('CLICKHOUSE_PASSWORD', '') }}"
      secure: false
      threads: 4

# =============================================================================
# harmoni — Environment Variables Reference
# Copy this file to .env and fill in real values. NEVER commit .env.
# All vars must be present here before being added anywhere in the codebase.
# =============================================================================

# --- Database (PostgreSQL 15) ---
DATABASE_URL=postgresql://harmoni:harmoni@localhost:5432/harmoni
DATABASE_TEST_URL=postgresql://harmoni:harmoni@localhost:5432/harmoni_test

# --- Analytics Store (ClickHouse) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=harmoni
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Cache / Session State (Redis 7) ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka / Confluent Platform ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# For production with SASL_SSL:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- ML / AI (OpenAI for auxiliary signal embeddings) ---
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BATCH_SIZE=100

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://harmoni:harmoni@localhost:5432/airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW__CORE__LOAD_EXAMPLES=False

# --- FastAPI Application ---
API_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
HARMONI_ADMIN_TOKEN=change-me-in-production-use-openssl-rand-hex-32
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_ALLOWED_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# --- Multi-tenancy ---
# schema = one PostgreSQL schema per tenant (default)
# database = one PostgreSQL database per tenant (stricter isolation)
TENANT_ISOLATION_MODE=schema

# --- Feature Flags ---
# CRITICAL: Never enable FEATURE_RL_ORCHESTRATOR in production without offline eval.
FEATURE_RL_ORCHESTRATOR=false

# --- Enrichment / Identity Resolution ---
CLEARBIT_API_KEY=
KICKFIRE_API_KEY=

# --- Outbound Webhook Dispatch ---
WEBHOOK_SIGNING_SECRET=change-me-in-production
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

# --- CRM Connectors ---
HUBSPOT_PRIVATE_APP_TOKEN=
SALESLOFT_API_KEY=

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
SENTRY_DSN=

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_APP_ENV=development
